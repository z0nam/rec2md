{#- 기본 HTML 양식(A4 인쇄용). 문맥: title, rows, spans, width, content, values, m, t (docs/templates.md) -#}
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if m.title and m.title != title %} — {{ m.title }}{% endif %}</title>
<style>
  @page { size: A4; margin: 18mm 16mm; }
  :root { --line: #333; --head: #eef1f5; --ink: #111; }
  * { box-sizing: border-box; }
  body { margin: 0; background: #fff; color: var(--ink);
         font-family: "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
         font-size: 10.5pt; line-height: 1.55; }
  main { max-width: 178mm; margin: 0 auto; padding: 8mm 0; }
  h1 { text-align: center; font-size: 20pt; letter-spacing: .4em; margin: 0 0 6mm; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { border: 1px solid var(--line); padding: 2mm 3mm; vertical-align: middle; word-break: keep-all; }
  th { background: var(--head); font-weight: 600; text-align: center; width: 22mm; white-space: nowrap; }
  td.block { vertical-align: top; }
  tr { break-inside: avoid; }
  tr.block { break-inside: auto; }
  .v { margin: 0; }
  .c { margin: 0; }
  .c.l0 { font-weight: 700; margin-top: 2.5mm; }
  .c.l0:first-child { margin-top: 0; }
  .c.l1 { padding-left: 3mm; }
  .c.l2 { padding-left: 7mm; }
  .c.l3 { padding-left: 11mm; }
  .c.l4 { padding-left: 15mm; }
  @media print { main { padding: 0; max-width: none; } }
</style>
</head>
<body>
<main>
<h1>{{ title }}</h1>
<table>
{% for row in rows %}
{% set span = spans[loop.index0] %}
  <tr{% if row[0][0].block %} class="block"{% endif %}>
{% for f, lines in row %}
    <th scope="row">{{ f.label }}</th>
{% if f.value == "content" %}
    <td class="block" colspan="{{ span[loop.index0] }}">
{% for ln in content %}
      <p class="c l{{ [ln.level, 4] | min }}">{{ ln.prefix }}{{ ln.text }}</p>
{% endfor %}
    </td>
{% else %}
    <td{% if f.block %} class="block"{% endif %} colspan="{{ span[loop.index0] }}">
{% for x in lines %}
      <p class="v">{{ x }}</p>
{% endfor %}
    </td>
{% endif %}
{% endfor %}
  </tr>
{% endfor %}
</table>
</main>
</body>
</html>
